{
  "manifest_version": 3,
  "name": "GH Browse or Reload Bridge",
  "version": "1.0",
  "description": "Bridges Python CLI with Chrome to reload existing GitHub tabs.",
  "permissions": ["tabs"],
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "ids": ["*"]
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}